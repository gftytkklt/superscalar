# ============================================================================
# npc/verif 生成产物（不入库）——与"测试代码"区分开：
#   保留的测试代码：tests/*.S、assert/*.sv、formal/{*.sby,props_*.sv,trim_rtl.py}
#                   tb_main.cpp、Makefile
#   生成的 trace/中间文件：Verilator build 输出、SymbiYosys 各设计输出目录与反例 trace
# ============================================================================

# Verilator 构建产物（模型、二进制、映像、日志、波形）
build/
# SDRAM 控制器定向回归 TB 的构建产物（verif/sdram/，由 run.sh 生成）
sdram/obj_dir/

# SymbiYosys 输出：formal/<design>/ 均为生成物（含 engine_0/trace*.vcd 反例轨迹）
formal/*/

# STA/综合产物（yosys-sta 与 .py 脚本生成）：网表副本、STA/功耗报告目录；只保留 .py 脚本本体
# result*/ 通配所有综合结果目录（result、result-n45、result-<pdk>-<freq>…），新增库/频率无需改本文件
sta/result*/
sta/*_synth.v

# 常见波形/反例/日志格式
*.fst
*.vcd
*.smtc
*.yw
*.log
# SDRAM 定向回归 TB：显式放行 run.sh（npc/.gitignore 白名单未含 *.sh）
!sdram/run.sh

# P-B 部件级频率探针：放行 probe_run.sh（npc/.gitignore 白名单未含 *.sh）
!sta/probe/probe_run.sh
