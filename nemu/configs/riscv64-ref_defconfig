# NPC reference model: devices belong to the DUT; keep the native profile separate.
CONFIG_ISA_riscv=y
CONFIG_RV64=y
CONFIG_TARGET_SHARE=y
# CONFIG_DEVICE is not set
# CONFIG_TRACE is not set
CONFIG_MBASE=0x80000000
CONFIG_MSIZE=0x8000000
CONFIG_FLASHBASE=0x30000000
CONFIG_FLASHSIZE=0x1000000
CONFIG_SRAMBASE=0x0f000000
CONFIG_SRAMSIZE=0x2000
CONFIG_MROMBASE=0x20000000
CONFIG_MROMSIZE=0x1000
CONFIG_SDRAMBASE=0xa0000000
CONFIG_SDRAMSIZE=0x8000000
CONFIG_PMEM_GARRAY=y
# CONFIG_MEM_RANDOM is not set
